---
// Starlight Footer override: the default doc footer (edit link, last updated, pagination)
// followed by a Spring-style sitemap that mirrors the main menu.
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
import { NAV } from './nav';

const isSplash = Astro.locals.starlightRoute?.entry?.data?.template === 'splash';
const columns = NAV.filter((i) => i.groups).map((i) => ({
	label: i.label,
	links: i.groups!.flatMap((g) => g.links).filter((l) => l.href),
}));
const year = new Date().getFullYear();
const updatedIso = new Date().toISOString().slice(0, 10);
---

<footer class="agb-footer">
	{
		!isSplash && (
			<>
				<p class="agb-standards">
					Verified against <a href="https://www.typescriptlang.org/docs/" target="_blank" rel="noopener">TypeScript 5.8</a> (<strong>100%</strong> compile-time Path Scope and DI verification), <a href="https://openrouter.ai/docs" target="_blank" rel="noopener">OpenRouter API</a> (<strong>200+</strong> supported chat and JEV decision endpoints), and <a href="https://opentelemetry.io/docs/specs/semconv/gen-ai/" target="_blank" rel="noopener">OpenTelemetry GenAI</a> (<strong>100%</strong> self-hosted trace compatibility).
				</p>
				<div class="meta">
					<EditLink />
					<LastUpdated />
				</div>
				<Pagination />
			</>
		)
	}

	{
		isSplash && (
			<div class="agb-sitemap">
				<div class="agb-sitemap-brand">
					<a href="/" class="agb-sitemap-logo">AGBoss <span>Framework</span></a>
					<p>Agent Graph Builder, Open-Source Software.<br /><a href="https://www.apache.org/licenses/LICENSE-2.0" target="_blank" rel="noopener">Apache 2.0</a> licensed.</p>
					<a class="agb-sitemap-roadmap" href="/roadmap/">See the roadmap →</a>
				</div>
				{
					columns.map((c) => (
						<div class="agb-sitemap-col">
							<p>{c.label}</p>
							<ul>
								{c.links.map((l) => (
									<li>
										<a href={l.href}>{l.label}</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		)
	}
	<p class="agb-copy">
		© {year} AGBoss · <a href="https://www.apache.org/licenses/LICENSE-2.0" target="_blank" rel="noopener">Apache 2.0</a> · Maintained by <a href="https://github.com/pavelravvich" rel="author">Pavel Ravvich</a> · Updated <time datetime={updatedIso}>{updatedIso}</time> · <a href="/llms.txt">llms.txt</a> · <a href="/llms-full.txt">llms-full.txt</a> · Not affiliated with LangChain or the Spring project.
	</p>
</footer>

<style>
	.agb-footer {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.agb-standards {
		margin: 2.5rem 0 0;
		padding-top: 1.25rem;
		border-top: 1px solid var(--sl-color-hairline);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}

	.agb-standards a {
		color: var(--sl-color-gray-2);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.75rem 3rem;
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}

	.agb-sitemap {
		display: grid;
		grid-template-columns: minmax(min(12rem, 100%), 1.4fr) repeat(auto-fit, minmax(min(8rem, 100%), 1fr));
		gap: 2rem 1.5rem;
		margin-top: 3rem;
		padding-top: 2.5rem;
		border-top: 1px solid var(--sl-color-hairline);
	}

	@media (max-width: 50rem) {
		.agb-sitemap {
			grid-template-columns: repeat(auto-fit, minmax(min(8rem, 100%), 1fr));
		}
		.agb-sitemap-brand {
			grid-column: 1 / -1;
		}
	}

	.agb-sitemap-logo {
		font-family: 'Exo 2', sans-serif;
		font-weight: 750;
		font-size: 1.1rem;
		color: var(--sl-color-accent-high);
		text-decoration: none;
	}

	.agb-sitemap-logo span {
		font-weight: 600;
		color: var(--sl-color-gray-2);
	}

	.agb-sitemap-brand p {
		margin: 0.6rem 0 0.9rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		line-height: 1.55;
	}

	.agb-sitemap-roadmap {
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-accent-high);
		text-decoration: none;
	}

	.agb-sitemap-col p {
		margin: 0 0 0.6rem;
		color: var(--sl-color-white);
		font-size: var(--sl-text-sm);
		font-weight: 600;
	}

	.agb-sitemap-col ul {
		display: grid;
		gap: 0.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.agb-sitemap-col a {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		text-decoration: none;
	}

	.agb-sitemap-col a:hover {
		color: var(--sl-color-white);
	}

	.agb-copy {
		margin: 0.5rem 0 1rem;
		color: var(--sl-color-gray-4);
		font-size: var(--sl-text-xs);
	}

	.agb-copy a {
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}

	.agb-copy a:hover {
		color: var(--sl-color-white);
	}
</style>
