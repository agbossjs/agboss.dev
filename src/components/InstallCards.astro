---
import { RELEASE_META } from '../config/release';

const isPublished = RELEASE_META.isPublishedToRegistry;
const packCmd = RELEASE_META.preReleaseCommands.packTarballs;
const installCmd = 'npm install @agboss/core @agboss/cli';
const createCmd = 'npx -p @agboss/cli agboss create my-app';
---

{
	isPublished ? (
		<div class="agboss-install-wrap" data-release-mode="published">
			<div class="agboss-install">
				<span class="agboss-install-prompt">$</span>
				<code>{installCmd}</code>
				<button
					class="agboss-copy"
					type="button"
					data-copy-text={installCmd}
					onclick="navigator.clipboard.writeText(this.dataset.copyText)"
					aria-label="Copy install command"
				>
					⧉
				</button>
			</div>
			<p class="agboss-install-sub">
				Starting from scratch? Run{' '}
				<code>{createCmd}</code>
				<button
					class="agboss-copy agboss-copy-inline"
					type="button"
					data-copy-text={createCmd}
					onclick="navigator.clipboard.writeText(this.dataset.copyText)"
					aria-label="Copy create project command"
					title="Copy create command"
				>
					⧉
				</button>
			</p>
		</div>
	) : (
		<div class="agboss-install-wrap" data-release-mode="pre-release">
			<div class="agboss-install">
				<span class="agboss-install-prompt">{RELEASE_META.displayVersion} $</span>
				<code>{packCmd}</code>
				<button
					class="agboss-copy"
					type="button"
					data-copy-text={packCmd}
					onclick="navigator.clipboard.writeText(this.dataset.copyText)"
					aria-label="Copy pre-release source build commands"
				>
					⧉
				</button>
			</div>
		</div>
	)
}
