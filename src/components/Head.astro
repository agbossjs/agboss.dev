---
import { execFileSync } from 'node:child_process';
import Default from '@astrojs/starlight/components/Head.astro';
import { RELEASE_META } from '../config/release';

const route = Astro.locals.starlightRoute;
const entry = route?.entry;
const title = entry?.data?.title ?? 'AGBoss';
const description =
	entry?.data?.description ??
	'AGBoss is an open-source TypeScript framework for multi-agent applications on LangGraph, combining dependency injection, typed dataflow, and static workflow verification.';

const siteOrigin = 'https://agboss.dev';
const pathname = Astro.url.pathname;
const canonicalUrl = new URL(pathname, siteOrigin).toString();
const isHome = pathname === '/' || pathname === '';
const pageTitle = isHome
	? 'AGBoss — Build Complex AI Workflows. Catch Graph Errors Before Runtime.'
	: `${title} | AGBoss Docs`;

if (isHome && entry?.data) {
	const bannerPrefix = RELEASE_META.isPublishedToRegistry
		? `AGBoss ${RELEASE_META.displayVersion}:`
		: `Pre-Release ${RELEASE_META.displayVersion}:`;
	if (entry.data.banner) {
		entry.data.banner.content = `<strong>${bannerPrefix}</strong> <a href="#executable-proof">Executable Path Scope Proof</a> · <a href="/features/">Interactive Feature Explorer</a> · <a href="/examples/job-scout/">7 Verified Examples</a> · <a href="/getting-started/quick-start/">Quickstart →</a>`;
	}
	const heroBadge = RELEASE_META.isPublishedToRegistry
		? RELEASE_META.displayVersion
		: `${RELEASE_META.displayVersion} (${RELEASE_META.releaseChannelLabel})`;
	if (entry.data.hero) {
		entry.data.hero.title = `<span class="hero-eyebrow">Apache-2.0 · TypeScript · Built on LangGraph · ${heroBadge}</span><span class="hero-headline">Build complex AI workflows.<br/>Catch graph errors before runtime.</span>`;
	}
}

if (route?.head) {
	for (const item of route.head) {
		if (item.tag === 'title') {
			item.content = pageTitle;
		} else if (item.tag === 'meta' && item.attrs) {
			if (item.attrs.property === 'og:title') {
				item.attrs.content = pageTitle;
			} else if (item.attrs.property === 'og:type') {
				item.attrs.content = 'website';
			} else if (item.attrs.property === 'og:site_name') {
				item.attrs.content = 'AGBoss';
			} else if (item.attrs.name === 'twitter:card') {
				item.attrs.content = 'summary_large_image';
			}
		}
	}
	// Remove duplicate og:type / og:site_name / og:image / twitter:card / twitter:image entries if Starlight merged head array
	const seenMeta = new Set<string>();
	route.head = route.head.filter((item) => {
		if (item.tag !== 'meta' || !item.attrs) return true;
		const key = String(item.attrs.property || item.attrs.name || '');
		if (
			key === 'og:type' ||
			key === 'og:site_name' ||
			key === 'og:image' ||
			key === 'twitter:card' ||
			key === 'twitter:image'
		) {
			if (seenMeta.has(key)) return false;
			seenMeta.add(key);
		}
		return true;
	});
}

const publishedDate = '2026-10-01';
function resolveGitLastMod(filePath?: string): string {
	try {
		const args = filePath
			? ['log', '-1', '--format=%cs', '--', filePath]
			: ['log', '-1', '--format=%cs'];
		const out = execFileSync('git', args, { encoding: 'utf8' }).trim();
		if (/^\d{4}-\d{2}-\d{2}$/u.test(out)) {
			return out;
		}
		const fallback = execFileSync('git', ['log', '-1', '--format=%cs'], {
			encoding: 'utf8',
		}).trim();
		if (/^\d{4}-\d{2}-\d{2}$/u.test(fallback)) {
			return fallback;
		}
	} catch {
		// Fall back to publishedDate when git metadata is unavailable
	}
	return publishedDate;
}
const modifiedDate = resolveGitLastMod(entry?.filePath);

const segments = pathname.split('/').filter(Boolean);
const breadcrumbItems = [
	{
		'@type': 'ListItem',
		position: 1,
		name: 'Home',
		item: `${siteOrigin}/`,
	},
	...segments.map((seg, idx) => {
		const pathUpTo = '/' + segments.slice(0, idx + 1).join('/') + '/';
		const label =
			idx === segments.length - 1
				? title
				: seg
						.split('-')
						.map((w) => w.charAt(0).toUpperCase() + w.slice(1))
						.join(' ');
		return {
			'@type': 'ListItem',
			position: idx + 2,
			name: label,
			item: new URL(pathUpTo, siteOrigin).toString(),
		};
	}),
];

const orgSchema = {
	'@type': 'Organization',
	'@id': `${siteOrigin}/#organization`,
	name: 'AGBoss',
	legalName: 'AGBoss',
	alternateName: 'Agent Graph Builder Open Source System',
	url: siteOrigin,
	logo: {
		'@type': 'ImageObject',
		url: `${siteOrigin}/favicon.svg`,
	},
	sameAs: [
		'https://github.com/agbossjs',
		'https://x.com/agbossjs',
		'https://www.linkedin.com/company/agbossjs',
	],
};

const websiteSchema = {
	'@type': 'WebSite',
	'@id': `${siteOrigin}/#website`,
	name: 'AGBoss',
	url: siteOrigin,
	description:
		'AGBoss is an open-source TypeScript framework for multi-agent applications on LangGraph, combining dependency injection, typed dataflow, and static workflow verification.',
	publisher: { '@id': `${siteOrigin}/#organization` },
};

const authorPerson = {
	'@type': 'Person',
	name: 'Pavel Ravvich',
	url: 'https://github.com/pavelravvich',
	sameAs: ['https://github.com/pavelravvich'],
};

const speakableSpec = {
	'@type': 'SpeakableSpecification',
	cssSelector: ['h1', '.hero-lead-copy', '.sl-markdown-content > p:first-of-type'],
};

const pageEntity = isHome
	? {
			'@type': ['SoftwareApplication', 'SoftwareSourceCode'],
			'@id': `${canonicalUrl}#software`,
			name: 'AGBoss',
			headline: title,
			description,
			url: canonicalUrl,
			image: `${siteOrigin}/og-image.png`,
			applicationCategory: 'DeveloperApplication',
			softwareVersion: RELEASE_META.softwareVersion,
			operatingSystem: 'Node.js, Cross-platform',
			programmingLanguage: 'TypeScript',
			codeRepository: 'https://github.com/agbossjs/agboss',
			license: 'https://www.apache.org/licenses/LICENSE-2.0',
			datePublished: publishedDate,
			dateModified: modifiedDate,
			author: authorPerson,
			publisher: { '@id': `${siteOrigin}/#organization` },
			speakable: speakableSpec,
			offers: {
				'@type': 'Offer',
				price: '0',
				priceCurrency: 'USD',
			},
		}
	: {
			'@type': 'TechArticle',
			'@id': `${canonicalUrl}#article`,
			headline: title,
			name: title,
			description,
			url: canonicalUrl,
			image: `${siteOrigin}/og-image.png`,
			datePublished: publishedDate,
			dateModified: modifiedDate,
			author: authorPerson,
			publisher: { '@id': `${siteOrigin}/#organization` },
			isPartOf: { '@id': `${siteOrigin}/#website` },
			speakable: speakableSpec,
		};

const graph: Record<string, unknown>[] = [orgSchema, websiteSchema, pageEntity];
if (!isHome && breadcrumbItems.length > 1) {
	graph.push({
		'@type': 'BreadcrumbList',
		'@id': `${canonicalUrl}#breadcrumb`,
		itemListElement: breadcrumbItems,
	});
}

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': graph,
};
---

<Default />
<link rel="llms" type="text/plain" href="/llms.txt" />
<link rel="alternate" type="text/markdown" href="/llms-full.txt" />
<meta property="article:published_time" content={publishedDate} />
<meta property="article:modified_time" content={modifiedDate} />
<meta name="author" content="Pavel Ravvich" />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<script src="/scripts/code-tabs.js" defer></script>

